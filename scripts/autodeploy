#!/bin/bash

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0;0m'

log_info() { echo -e "${BLUE}[INFO] $(date +'%Y-%m-%d %H:%M:%S') - $1${NC}"; }
log_success() { echo -e "${GREEN}[SUCCESS] $1${NC}"; }
log_error() { echo -e "${RED}[ERROR] $1${NC}"; }


if [ ! -f "docker-compose.yml" ]; then
    log_error "Error: the file docker-compose.yml could not be found."
    exit 1
fi

if [ -f ".env" ]; then
    log_info "Loading environment variables from .env..."
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
fi

log_info "Beginning automatic deployment..."

if [ -d ".git" ]; then
    log_info "Fetching the latest code from Git..."
    git pull origin main
fi

log_info "Stopping the old infrastructure..."
docker compose down

log_info "Building the containers..."
docker compose build --no-cache
log_info "Starting the new infrastructure..."
docker compose up -d


log_info "Waiting for PostgreSQL initialization..."
until docker compose exec -T postgres pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" > /dev/null 2>&1; do
    echo -n "."
    sleep 1
done
echo ""

log_info "Execution of Django migrations..."
docker compose exec backend python manage.py makemigrations --noinput
docker compose exec backend python manage.py makemigrations pathology_app --noinput

log_info "Applying pre-migration schema fixes..."
docker compose exec -T postgres psql -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" \
    -c "ALTER TABLE pathology_app_question ADD COLUMN IF NOT EXISTS question_options jsonb;" \
    2>/dev/null || true

log_info "Applying migrations..."
docker compose exec -T backend python manage.py migrate --noinput

log_info "Verification and creation of Django superuser..."

docker compose exec -T \
  -e DJANGO_SUPERUSER_USERNAME="${DJANGO_SUPERUSER_USERNAME}" \
  -e DJANGO_SUPERUSER_EMAIL="${DJANGO_SUPERUSER_EMAIL}" \
  -e DJANGO_SUPERUSER_PASSWORD="${DJANGO_SUPERUSER_PASSWORD}" \
  backend python manage.py createsuperuser --noinput || log_info "The superuser already exists or could not be created (Ignored)."

log_info "Cleaning up obsolete Docker images..."
docker image prune -f

log_success "Deployment completed successfully! The application is now live."
